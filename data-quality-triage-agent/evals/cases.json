{
  "suite": "data-quality-triage-agent",
  "version": 1,
  "description": "Casos de evaluación independientes de AGENT_INSTRUCTIONS y de cualquier prompt.",
  "cases": [
    {
      "id": "DQ-01",
      "name": "Frescura crítica en dataset gold",
      "input": {
        "request": "Revisa el dataset gold de pedidos.",
        "metadata": {
          "dataset_id": "orders_gold",
          "is_critical": true,
          "tier": "gold",
          "owner": "data-platform"
        },
        "metrics": {
          "null_count": 0,
          "duplicate_count": 0,
          "complete": true
        },
        "freshness": {
          "delay_seconds": 14400,
          "sla_seconds": 3600,
          "critical_flow_unavailable": false
        }
      },
      "expected": {
        "severity": "P1",
        "needs_human_approval": true,
        "must_include": [
          "retraso de frescura >= 3x SLA"
        ],
        "must_not_claim": [
          "causa raíz sin evidencia"
        ]
      }
    },
    {
